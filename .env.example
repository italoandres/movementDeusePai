# Supabase Configuration
# Copy this file to .env.local and replace with your actual values
# Get these values from: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mercado Pago Configuration
# Get these from: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=your-access-token-here
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret-here
# Public app URL. Local: http://localhost:3000 | Production (Vercel): https://nosecreto.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
